# MongoDB Configuration (Use MongoDB Atlas connection string for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dm-eas?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long_2026
JWT_EXPIRE=7d

# Server Configuration (Render automatically assigns PORT)
PORT=10000
NODE_ENV=production

# CORS Configuration (Set to your Vercel frontend URL, supports comma-separated list)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# File Upload Limit (in bytes: 52428800 = 50MB)
MAX_FILE_SIZE=52428800

# Twilio & WhatsApp First-Responder Alerts (Optional - for automated emergency dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ALERT_RECIPIENTS=+919999999999,+918888888888

# AI Image Verification (Optional - Sightengine or HuggingFace)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
HUGGINGFACE_API_KEY=

# Default Admin Seeding Configuration
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_USERID=admin_user
DEFAULT_ADMIN_EMAIL=admin@demo.com
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_DEPARTMENT=admin

